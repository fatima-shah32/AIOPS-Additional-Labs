pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                echo 'Repository already available in Jenkins workspace'
            }
        }

        stage('Setup Python Environment') {
            steps {
                sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install pandas scikit-learn joblib
                '''
            }
        }

        stage('Train ML Model') {
            steps {
                sh '''
                . venv/bin/activate
                python train_model.py
                '''
            }
        }

        stage('Build') {
            steps {
                echo 'Running sample build step'
                sh 'echo Build completed successfully'
            }
        }

        stage('Test') {
            steps {
                echo 'Running sample test step'
                sh 'echo Tests completed successfully'
            }
        }

        stage('Predict Build Outcome') {
            steps {
                sh '''
                . venv/bin/activate
                python predict_build_outcome.py
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '*.txt,*.csv,*.pkl', fingerprint: true
        }
    }
}
